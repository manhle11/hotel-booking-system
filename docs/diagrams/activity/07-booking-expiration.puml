@startuml
!include ../common/style.puml
title HANBAY - Exact hold expiry and periodic status update
start
:now = backend clock instant;
note right
  Availability and confirm guard exclude
  PENDING at now >= expiredAt immediately.
  Status may still read PENDING before job runs.
end note
:Configured cron triggers scheduler;
:Begin transaction and lock PENDING rows
with non-null expiredAt <= now;
if (Any expired rows?) then (Yes)
repeat
  :Validate pending expiry;
  :Set EXPIRED, clear expiredAt, append history;
repeat while (More rows?) is (Yes)
:Save and commit;
else (No)
  :No-op transaction;
endif
note right
  Hold duration configured, default 15min.
  Edit/QR recreation does not renew hold.
  No physical room was assigned;
  no automatic checkout of occupied guests.
end note
stop
@enduml
