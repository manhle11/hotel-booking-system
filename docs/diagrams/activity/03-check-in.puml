@startuml
!include ../common/style.puml
title HANBAY - Check-in with shared hotel time
|Receptionist|
start
:Enter confirmed booking code;
|System|
:Validate CONFIRMED and hotel arrival window;
if (Booked day OR yesterday before06 with checkout >= today?) then (Yes)
else (No)
  :Reject CHECK_IN_DATE_NOT_ALLOWED;
  stop
endif
if (Before14 on booked day?) then (Yes)
  |Receptionist|
  :Provide nonblank earlyArrivalReason, max 500;
  |System|
  if (Valid reason?) then (Yes)
  else (No)
    :Return field validation error;
    stop
  endif
endif
:List correct-type AVAILABLE rooms without assigned conflicts;
|Receptionist|
:Choose physical room;
|System|
:Lock booking and selected room in transaction;
:Revalidate state, arrival window, room and assigned conflicts;
if (Still valid?) then (Yes)
  :Assign room; set OCCUPIED and CHECKED_IN;
  :Save actual UTC checked_in_at and status reason;
  :Commit;
else (No)
  :Rollback and return validation/conflict;
endif
stop
@enduml
